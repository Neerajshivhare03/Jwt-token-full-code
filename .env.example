# Copy these values into your local environment / IDE Run Configuration.
# Spring Boot does not automatically load .env files.
DB_URL=jdbc:mysql://localhost:3306/hmsdb
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-database-password
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
JWT_ISSUER=hms-api
JWT_EXPIRY_MS=86400000
DDL_AUTO=update
SHOW_SQL=false
